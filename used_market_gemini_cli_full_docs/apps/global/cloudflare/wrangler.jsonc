{
  "$schema": "https://unpkg.com/wrangler@4/config-schema.json",
  "name": "used-market-global",
  "main": "./worker.mjs",
  "compatibility_date": "2026-08-19",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "global.used-pick.com",
      "custom_domain": true
    }
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "RUNNER_URL": "https://global-runner.used-pick.com"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "assets": {
    "directory": "../web-backend/public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "used-market-global-free",
      "database_id": "54c77815-6250-4e10-858d-4a017bd8e1ec",
      "migrations_dir": "./migrations"
    }
  ]
}
