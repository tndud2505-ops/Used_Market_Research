# Provider
MODEL_PROVIDER=gemini
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=
ALLOW_MOCK_FALLBACK=false
OUTPUT_PRETTY=true
CLI_TRACE=false
CLI_TRACE_PROMPTS=false
GEMINI_STREAM_OUTPUT=false
DEBUG_CONSOLE=false
API_PORT=8787
HOST=127.0.0.1
PORT=8787
NODE_ENV=development
PUBLIC_API_ONLY=false
CORS_ALLOWED_ORIGINS=

# Search resource controls
SEARCH_CONCURRENCY_LIMIT=1
SEARCH_RETRY_AFTER_SECONDS=5
SEARCH_MAX_WORK_UNITS=12
SEARCH_CACHE_TTL_SECONDS=120
SEARCH_CACHE_MAX_ENTRIES=32

# Local Chromium collector (no marketplace API)
LOCAL_BROWSER_BINARY=
LOCAL_BROWSER_COMMAND_TIMEOUT_MS=15000
LOCAL_BROWSER_NO_SANDBOX=false

# eBay Browse API Production OAuth credentials
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# Optional short-lived override. Prefer the two credentials above for automatic renewal.
EBAY_BROWSE_API_TOKEN=

# Google Sheets (reporter)
GOOGLE_SHEETS_SPREADSHEET_ID=your_spreadsheet_id
GOOGLE_SHEETS_CREDENTIALS_JSON=secrets/sheets-service-account.json
NAVER_OPENAPI_CLIENT_ID=your_naver_openapi_client_id
NAVER_OPENAPI_CLIENT_SECRET=your_naver_openapi_client_secret

# Reporter
REPORTER_ENABLED=true
REPORTER_KILL_SWITCH=false
REPORTER_POLL_INTERVAL_SEC=300
REPORTER_SEND_ENABLED=false
REPORTER_MAX_PER_SELLER_PER_DAY=2
REPORTER_QUIET_HOURS=23-08
REPORTER_DEDUPE_TTL_HOURS=72
REPORTER_DAEMON_STATUS_FILE=merge/result/reporter/daemon-status.json
REPORTER_BLOCK_MOCK_SHEET_UPLOADS=true
REPORTER_SUMMARY_ENABLED=false
REPORTER_SUMMARY_WEBHOOK_URL=your_summary_webhook_url
REPORTER_SUMMARY_MAX_ITEMS=6
DISCORD_WATCH_ENABLED=false
DISCORD_WATCH_BOT_TOKEN=your_discord_bot_token
DISCORD_WATCH_CHANNEL_IDS=your_channel_id_1,your_channel_id_2
DISCORD_WATCH_GUILD_ID=your_guild_id
DISCORD_WATCH_COMMAND_PREFIX=!watch
DISCORD_WATCH_POLL_LIMIT=25

# Message dispatch
MESSAGE_PROVIDER=webhook
MESSAGE_WEBHOOK_URL=your_message_webhook_url
MESSAGE_TEMPLATE_VERSION=v1

# Scheduler
SCHEDULER_TIMEZONE=Asia/Seoul
SCHEDULER_DAEMON_STATUS_FILE=merge/result/scheduler/daemon-status.json
SCHEDULER_ALERT_EMAIL_WEBHOOK_URL=

# Cloudflare Worker -> Node runner bridge
CLOUDFLARE_RUNNER_TOKEN=replace_with_a_long_random_token
CLOUDFLARE_RUNNER_URL=https://replace-with-public-node-runner.example.com/api/runner/run
CLOUDFLARE_ORIGIN_URL=https://replace-with-public-node-runner.example.com

# Free Cloudflare Worker mode (Worker + Browser Run + D1 + Queue)
CLOUDFLARE_FREE_TIER_MODE=true
CLOUDFLARE_FREE_TIER_SEARCH_CACHE_TTL_SECONDS=21600
CLOUDFLARE_FREE_TIER_STATIC_CACHE_TTL_SECONDS=86400
CLOUDFLARE_FREE_TIER_MAX_SEARCH_LIMIT=40
