NODE_ENV=production
PORT=8790
HOST=127.0.0.1
PUBLIC_API_ONLY=true
SEARCH_CONCURRENCY_LIMIT=1
SEARCH_RETRY_AFTER_SECONDS=5
SEARCH_MAX_WORK_UNITS=12
SEARCH_CACHE_TTL_SECONDS=120
SEARCH_CACHE_MAX_ENTRIES=32
LOCAL_BROWSER_BINARY=/usr/bin/chromium
LOCAL_BROWSER_NO_SANDBOX=true
LOCAL_BROWSER_COMMAND_TIMEOUT_MS=15000
MERGE_RESULT_BASE=/var/lib/used-market-global-runner/results
TRANSACTION_RESULT_BASE=/var/lib/used-market-global-runner/results/transactions
RUNNER_IDEMPOTENCY_FILE=/var/lib/used-market-global-runner/runner-idempotency.json
CLOUDFLARE_RUNNER_TOKEN=
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
NODE_OPTIONS=--max-old-space-size=1100
