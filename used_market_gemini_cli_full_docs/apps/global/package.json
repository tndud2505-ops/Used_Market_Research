{
  "name": "used-market-global",
  "version": "2.0.0",
  "description": "Independent Japan and United States used-listings search application",
  "type": "module",
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "bin": {
    "used-market": "dist/MCP/logic/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/MCP/logic/index.js --debug-console",
    "dev": "node --loader ts-node/esm MCP/logic/index.ts --debug-console",
    "provider-check": "node dist/MCP/logic/index.js provider-check",
    "sites": "node dist/MCP/logic/index.js sites",
    "web": "node --env-file-if-exists=.env dist/web-backend/logic/index.js",
    "scheduler": "node --env-file-if-exists=.env dist/scheduler/logic/index.js",
    "foreign:contract": "npm run build && node harness/foreign-site-contract.mjs",
    "us:policy": "npm run build && node harness/us-search-policy-contract.mjs",
    "search:session": "npm run build && node harness/search-session-policy-contract.mjs",
    "search:server-session": "npm run build && node harness/server-search-session-contract.mjs",
    "us:matrix:live": "npm run build && node harness/us-search-matrix-live.mjs",
    "foreign:ui": "node harness/foreign-ui-contract.mjs",
    "foreign:english-ui": "node harness/foreign-english-ui-contract.mjs",
    "cloudflare:harness": "node cloudflare/harness.mjs",
    "cloudflare:deploy": "node cloudflare/deploy.mjs",
    "cloudflare:release": "node cloudflare/release.mjs",
    "runner:contract": "node aws-runner/runner-contract.mjs",
    "test": "npm run build && node harness/app-isolation-contract.mjs && node harness/wiki-contract.mjs && node harness/ops-deployment-contract.mjs && node harness/runtime-isolation-contract.mjs && node harness/cloudflare-runner-boundary-contract.mjs && node aws-runner/runner-contract.mjs && node cloudflare/harness.mjs && node harness/ebay-api-contract.mjs && node harness/us-search-policy-contract.mjs && node harness/search-session-policy-contract.mjs && node harness/server-search-session-contract.mjs && node harness/foreign-site-contract.mjs && node harness/foreign-search-controls-contract.mjs && node harness/search-cache-contract.mjs",
    "test:ui": "npm run build && node harness/run-ui-contracts.mjs"
  },
  "dependencies": {
    "commander": "^14.0.0",
    "googleapis": "^171.4.0",
    "node-cron": "^4.2.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/playwright": "^1.3.0",
    "@playwright/cli": "0.1.18",
    "@types/node": "^24.6.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
