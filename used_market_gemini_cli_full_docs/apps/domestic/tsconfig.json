{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "declaration": false
  },
  "include": [
    "MCP/**/*.ts",
    "collector/**/*.ts",
    "market/**/*.ts",
    "scheduler/**/*.ts",
    "reporter/**/*.ts",
    "web-backend/**/*.ts",
    "merge/**/*.ts",
    "tests/**/*.ts"
  ]
}
