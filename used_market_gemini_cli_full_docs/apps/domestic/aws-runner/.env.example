# 이 파일은 예시다. 실제 값은 AWS의 /etc/used-market-runner/runner.env에 저장한다.
# 토큰을 Git에 커밋하지 않는다.

RUNNER_PORT=8787
CLOUDFLARE_RUNNER_TOKEN=replace-with-a-long-random-token
RUNNER_PUBLIC_URL=https://runner.example.com

# eBay Browse API Production OAuth credentials
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# Optional short-lived override. Prefer automatic renewal with the credentials above.
EBAY_BROWSE_API_TOKEN=

# Optional: live search cache duration in milliseconds (default: 60000, max: 600000).
RUNNER_SEARCH_CACHE_TTL_MS=300000

# AWS 로컬 SQLite 검색 색인. 이미지 파일과 원본 HTML은 저장하지 않는다.
RUNNER_INDEX_ENABLED=true
# 첫 배포는 shadow, 24시간 비교 후 cache_first로 전환한다.
RUNNER_INDEX_MODE=shadow
RUNNER_INDEX_DIR=/var/lib/used-market-runner
RUNNER_INDEX_PATH=/var/lib/used-market-runner/search-index.sqlite
# PC 원장과 검색 색인을 함께 저장하는 운영 DB 한도입니다. AWS 디스크 여유를
# 확인한 뒤 설정하며, soft는 정리 경고·hard는 백그라운드 쓰기 중단 경계입니다.
RUNNER_INDEX_SOFT_LIMIT_BYTES=3221225472
RUNNER_INDEX_HARD_LIMIT_BYTES=4294967296

# PC 전용 원장은 검색 결과를 shadow dual-write한다. 고주기 source scheduler는
# 정책 확인과 30일 병행 수집 시작을 운영자가 승인한 뒤에만 true로 바꾼다.
PC_PARTS_SHADOW_WRITE_ENABLED=true
PC_PARTS_SCHEDULER_ENABLED=false
# 한 번의 source 실행에서 시간순으로 처리할 최대 target 수와 일반 마켓 동시 요청 수입니다.
# 매시간 부품군 target을 먼저 처리하고, 남는 슬롯으로 전체 제품 master를 24시간 순회합니다.
PC_SOURCE_TARGETS_PER_RUN=64
PC_SOURCE_TARGET_CONCURRENCY=6
# registry에 기록된 운영자 승인 또는 아래 명시 설정을 source별 실행 근거로 사용합니다.
PC_SOURCE_GOVERNANCE_JSON={}
# 다나와는 내장 카테고리 adapter를 사용합니다. 이 값은 향후 승인된 URL이 필요한 전문 소스용입니다.
PC_SPECIALIST_SEARCH_URLS_JSON={}
# Alias ID 또는 정규화 alias별 고정 검증 precision과 회귀 통과 증거. 기본은 승격 차단입니다.
PC_ALIAS_PROMOTION_EVIDENCE_JSON={}
# 선택: 버전 키별 인간 검수 품질 보고서 JSON. 일일 publication 전에 자동 승격/롤백 판정에 사용합니다.
PC_PIPELINE_QUALITY_REPORTS_PATH=

# 선택: 설정하면 runner.mjs가 수집 결과를 이 HTTPS 엔드포인트로 POST한다.
# payload는 {"listings":[...]} 형식이어야 한다.
D1_IMPORT_URL=
D1_STATS_IMPORT_URL=
CLOUDFLARE_MANUAL_RUN_TOKEN=

# install-ubuntu24.sh가 실제 경로로 채운다.
CHROMIUM_PATH=/usr/bin/chromium
NODE_OPTIONS=--max-old-space-size=2048

# Tunnel 토큰은 환경변수에 넣지 않고 다음 root-only 파일에 저장한다.
# /etc/cloudflared/used-market-runner.token
