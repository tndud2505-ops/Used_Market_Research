[Unit]
Description=Used Market AWS Node Runner
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=__RUNNER_USER__
Group=__RUNNER_USER__
StateDirectory=used-market-runner
StateDirectoryMode=0750
WorkingDirectory=__APP_ROOT__
EnvironmentFile=-__RUNNER_ENV_FILE__
ExecStart=/usr/bin/node __APP_ROOT__/aws-runner/runner.mjs
Restart=on-failure
RestartSec=5
MemoryHigh=2560M
MemoryMax=3072M
TimeoutStopSec=20
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
UMask=0027

[Install]
WantedBy=multi-user.target
